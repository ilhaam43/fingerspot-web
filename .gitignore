# Public source allowlist. Private exports, uploads, credentials, database files,
# legacy binaries, dated backups, screenshots, and Word forms stay local.
*
!/.gitignore
!/.dockerignore
!/.env.example
!/Dockerfile
!/compose.yaml
!/app.py
!/requirements.txt
!/requirements-docker.txt
!/README.md
!/config/
!/config/*.json
!/database/
!/database/*.py
!/database/*.sql
!/database/*.md
!/examples/
!/examples/*.xlsx
!/examples/*.md
!/files/
!/files/README.md
!/templates/
!/templates/*.html
!/static/
!/static/**
!/scripts/
!/scripts/audit_public.py
!/fingerspot-new/
!/fingerspot-new/app.py
!/fingerspot-new/routes/
!/fingerspot-new/routes/*.py
!/fingerspot-new/utils/
!/fingerspot-new/utils/*.py
!/fingerspot-new/templates/
!/fingerspot-new/templates/**
!/fingerspot-new/static/
!/fingerspot-new/static/**
**/__pycache__/
**/*.pyc
**/.env
/static/img/screenshot_file_lemburan.png
/static/img/test_1.jpg
